[Unit]
Description=Cabinet backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/cabinet/app
EnvironmentFile=%h/cabinet/app/runtime.env
EnvironmentFile=-%h/cabinet/app/runtime-extra.env
Environment=PORT=8080
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=75 -jar %h/cabinet/app/app.jar
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=default.target
